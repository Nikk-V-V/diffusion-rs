+// Game Harness: GGML_OP_ROPE_APPLY, the port of the CUDA kernel. One threadgroup per (token, head, batch), one
+// thread per pair. dst is [d_head, tokens, heads*batch], contiguous.
+kernel void kernel_rope_apply_f32(
+    constant ggml_metal_kargs_rope_apply & args,
+    device  const char * x,
+    device  const char * pe,
+    device        char * dst,
+    uint3 tgpig[[threadgroup_position_in_grid]],
+    uint3 tpitg[[thread_position_in_threadgroup]],
+    uint3   ntg[[threads_per_threadgroup]]) {
+    const int64_t token = tgpig.x;
+    const int64_t head  = tgpig.y;
+    const int64_t batch = tgpig.z;
+    const int     half_dim = args.ne00/2;
+
+    device const char * x_row = x + head*args.nb01 + token*args.nb02 + batch*args.nb03;
+    device float * out = (device float *) dst + ((batch*args.ne01 + head)*args.ne02 + token)*args.ne00;
+
+    for (int j = tpitg.x; j < half_dim; j += ntg.x) {
+        const int i0 = args.interleaved ? 2*j     : j;
+        const int i1 = args.interleaved ? 2*j + 1 : j + half_dim;
+        const float a = *(device const float *) (x_row + i0*args.nb00);
+        const float b = *(device const float *) (x_row + i1*args.nb00);
+        device const char * m = pe + j*args.nb12 + token*args.nb13;
+        const float m00 = *(device const float *) (m);
+        const float m01 = *(device const float *) (m + args.nb10);
+        const float m10 = *(device const float *) (m + args.nb11);
+        const float m11 = *(device const float *) (m + args.nb10 + args.nb11);
+        if (args.interleaved) {
+            out[i0] = a*m00 + b*m01;
+            out[i1] = a*m10 + b*m11;
+        } else {
+            out[i0] = a*m00 - b*m10;
+            out[i1] = a*m10 + b*m00;
+        }
+    }
+}
