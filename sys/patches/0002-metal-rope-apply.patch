+int ggml_metal_op_rope_apply(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+
+    ggml_metal_library_t lib = ctx->lib;
+    ggml_metal_encoder_t enc = ctx->enc;
+
+    const ggml_tensor * x  = op->src[0];
+    const ggml_tensor * pe = op->src[1];
+
+    GGML_ASSERT(ggml_is_contiguous(op));
+
+    ggml_metal_kargs_rope_apply args = {
+        /*.ne00 =*/ (int32_t) x->ne[0],
+        /*.ne01 =*/ (int32_t) x->ne[1],
+        /*.ne02 =*/ (int32_t) x->ne[2],
+        /*.nb00 =*/ x->nb[0],
+        /*.nb01 =*/ x->nb[1],
+        /*.nb02 =*/ x->nb[2],
+        /*.nb03 =*/ x->nb[3],
+        /*.nb10 =*/ pe->nb[0],
+        /*.nb11 =*/ pe->nb[1],
+        /*.nb12 =*/ pe->nb[2],
+        /*.nb13 =*/ pe->nb[3],
+        /*.interleaved =*/ ggml_get_op_params_i32(op, 0),
+    };
+
+    auto pipeline = ggml_metal_library_get_pipeline_rope_apply(lib, op);
+
+    const int nth = std::min(1024, (int) (x->ne[0]/2));
+
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(x),  1);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(pe), 2);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op), 3);
+
+    ggml_metal_encoder_dispatch_threadgroups(enc, x->ne[2], x->ne[1], x->ne[3], nth, 1, 1);
+
+    return 1;
+}
